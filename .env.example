# Bu dosyayı .env adıyla kopyalayın ve kendi yerel PostgreSQL bilgilerinizle doldurun.
# .env dosyası .gitignore tarafından dışlanır; gerçek parolayı bu örnek dosyaya yazmayın.
DB_URL=jdbc:postgresql://localhost:5432/mealflex
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgresql-password

# PostGIS geçişi: yerel PostgreSQL'de PostGIS yoksa HAVERSINE olarak bırakın.
LOCATION_DISTANCE_ENGINE=HAVERSINE
LOCATION_SHADOW_TOLERANCE_METERS=100
# PostGIS kurulu ortamlarda spatial migration'ı etkinleştirin:
# FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/spatial-migration
