# Bu dosyayı .env.staging olarak kopyalayın. Gerçek sırları repoya eklemeyin.
DB_NAME=mealflex_staging
DB_USERNAME=mealflex_app
DB_PASSWORD=replace-with-a-long-random-password

# Harf, rakam, nokta, tire ve alt çizgi içeren benzersiz yayın etiketi.
APP_VERSION=0.1.0-staging

# Alan adının A/AAAA kaydı staging sunucusunu göstermelidir.
PUBLIC_HOST=staging.example.com
PUBLIC_BASE_URL=https://staging.example.com
TLS_EMAIL=ops@example.com

# En az 32 karakterlik, birbirinden farklı rastgele değerler kullanın.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# check-staging.sh eşikleri. Zorunlu değildir; değer verilmezse 26 saat ve %80 kullanılır.
BACKUP_MAX_AGE_HOURS=26
DISK_USAGE_WARN_PERCENT=80
